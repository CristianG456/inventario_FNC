APP_NAME="Inventario de Equipos"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_TIMEZONE=America/Bogota

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug


# BASE DE DATOS

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306

DB_DATABASE=inventario
DB_USERNAME=inventario
DB_PASSWORD=InventariO_FNC_2026
DB_ROOT_PASSWORD=Root_Invetario_FNC_2026

# ADMINISTRADOR INICIAL

SYSTEM_ADMIN_NAME=ADMINISTRADOR
SYSTEM_ADMIN_EMAIL=admin@inventario.com
SYSTEM_ADMIN_PASSWORD=Admin123!-
SYSTEM_FORCE_PASSWORD_CHANGE=true


# SESIONES

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null


# CACHE

CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log


# REDIS

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


# CORREO

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"


# AWS

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# VITE

VITE_APP_NAME="${APP_NAME}"


# BACKUPS

BACKUP_PASSWORD=
KOPIA_PASSWORD=


# CLOUDFLARE R2

CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=


# GOOGLE

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=